/*
 * mtk64ebt 用キーマップ: Keyball44 (Remap チートシート) ベース + 個別調整 (第4版)
 *
 * 置き場所: フォークした zmk-config-mtk64 の config/mtk64.keymap (上書き)
 * 対象ブランチ: right_left_rev4 (右手ボール・Bluetooth 直結)
 * OS のキーボード設定は「日本語 (JIS)」前提。
 *
 * ■ レイヤーの対応 (Keyball -> mtk64ebt)。表示名は Keyball の番号に合わせて L0〜L3
 *   Layer 0 -> レイヤー0 (L0)
 *   Layer 1 -> レイヤー4 (L1)   TO(1) は &to 4。右下の角で L1 <-> L0 を行き来する
 *   Layer 2 -> レイヤー5 (L2)   MO(2) は &mo 5
 *   Layer 3 -> レイヤー3 (L3)   TO(3)/MO(3) は &to 3 / &mo 3。mtk のスクロール用レイヤーなので、
 *                                Keyball と同じく、このレイヤーではボールがスクロールになる
 *   Layer 4 は使わない (移植していない)
 *   レイヤー1 (SNP: 精密モード・設定・BT切替) / 2 (MSE: マウス・Fキー) は公式のまま。
 *
 * ■ 物理配置の対応 (これまでのファームと同じ考え方)
 *   英字3段 (6列x3段)          -> 上から2〜4段目の同じ位置 (最上段の数字段は公式のまま)
 *   左の最下段2キー (TO(1), MO(2) の位置) -> ? の右隣 / 親指の一番手前の低いキー
 *   左親指3キー                -> 親指アーチ 外側から順
 *   右親指2キー                -> 親指アーチ 内側から順
 *   右下のキー (Alt の位置)    -> 右親指アーチの外側
 *
 * ■ Keyball に無いキー (これまでのファームから変更なし)
 *   左下の角 = 長押しでスクロール(&mo 3) / その右 = Win / 右下の角の左隣 = 長押しで精密・設定(&mo 1)
 *   G の左隣 = 長押しで L1 / 右親指の一番手前 = 長押しで L2
 *   数字段・エンコーダー押し込み・フットスイッチ = 公式のまま
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include "keycode_japanese.h"

// スクロール量の設定
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mkp_input_listener {
    input-processors = <&zip_aml 6 5000>;
};

// 自動マウスレイヤー中も「取り消し」にならないキー位置 (= レイヤー6 のマウスボタンの位置)
&zip_aml {
    excluded-positions = <33 34 44 46>;
};

/ {
    behaviors {
        // 垂直スクロール用のbehaviorの設定
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>; // スクロールのタップ時間
        };
        // 水平スクロール用のbehaviorの設定
        scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>; // スクロールのタップ時間
        };
    };
};

/ {
    macros {
        // 「」キー: JIS の [ と ] を続けて入力する (日本語入力中は「」になる)
        kagi_pair: kagi_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp JP_LBKT &kp JP_RBKT>;
        };
    };
};

/ {

    keymap {
        compatible = "zmk,keymap";

        // ===== レイヤー0: Keyball Layer 0 + 調整 (: / BS / Del / 「」 / Space / PrintScreen / 右クリック / Enter / L1切替) =====
        default_layer {
            display-name = "L0";
            bindings = <
&kp ESC      &kp N1    &kp N2  &kp N3     &kp N4  &kp N5                                  &kp N6     &kp N7    &kp N8     &kp N9  &kp N0  &kp BSPC
&kp JP_ZKHK  &kp Q     &kp L   &kp U      &kp JP_COLON  &kp JP_EXCL                             &kp F      &kp W     &kp R      &kp Y   &kp P   &kp DEL
&kp JP_HENK  &kp E     &kp I   &kp A      &kp O   &kp JP_MINUS                            &kp K      &kp T     &kp N      &kp S   &kp H   &kagi_pair
&kp LCTRL    &kp Z     &kp X   &kp C      &kp V   &kp JP_QMARK  &kp SPACE           &mo 4     &kp G      &kp D     &kp M      &kp J   &kp B   &kp RSHFT
&mo 3        &kp LGUI                             &kp COMMA     &kp DOT         &mkp MB2 &kp ENTER                                &mo 1   &to 4
                       &tog 2  &kp ENTER                        &kp PSCRN       &mkp MB1                       &kp ENTER  &tog 2
                                                                &mo 5           &mo 5
             &mo 1     &mo 2   &mo 3                                                                           &mo 1      &mo 2   &mo 3
                                                                &mo 1    &mo 2  &mo 3
            >;

            sensor-bindings = <
                &inc_dec_kp LEFT_ARROW RIGHT_ARROW
                &inc_dec_kp UP_ARROW   DOWN_ARROW
            >;
        };

        // ===== レイヤー1: 精密モード・設定・BT切替 (公式のまま) =====
        layer_1 {
            display-name = "SNP";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5
                                                                    &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &studio_unlock
&trans  &kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                    &trans            &kp PG_UP          &kp UP_ARROW    &kp PG_DN             &trans                &scrl_inv_tog
&trans  &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                                &kp HOME          &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp END               &aml_tog
&trans  &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &mkp MB4       &mkp MB5          &mkp MB1           &mkp MB2        &mkp MB3              &trans                &cpi_inc
&trans  &trans                                                                         &trans        &trans         &trans         &trans                                                                     &trans                &cpi_dec
                                    &trans           &trans                                          &trans         &trans                                              &trans          &trans
                                                                                                     &trans         &trans
        &trans                      &trans           &trans                                                                                                             &trans          &trans                &trans
                                                                                                     &trans &trans  &trans
            >;
        };

        // ===== レイヤー2: マウス・Fキー (公式のまま) =====
        layer_2 {
            display-name = "MSE";
            bindings = <
&trans  &kp F1                      &kp F2           &kp F3           &kp F4           &kp F5                                      &kp F6            &kp F7             &kp F8          &kp F9                &kp F10               &kp F11
&trans  &kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                    &trans            &kp PG_UP          &kp UP_ARROW    &kp PG_DN             &trans                &trans
&trans  &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                                &kp HOME          &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp END               &trans
&trans  &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &mkp MB4       &mkp MB5          &mkp MB1           &mkp MB2        &mkp MB3              &trans                &trans
&trans  &trans                                                                         &trans        &trans         &trans         &trans                                                                     &trans                &trans
                                    &trans           &trans                                          &trans         &trans                                              &trans          &trans
                                                                                                     &trans         &trans
        &trans                      &trans           &trans                                                                                                             &trans          &trans                &trans
                                                                                                     &trans &trans  &trans
            >;
            sensor-bindings = <
                &inc_dec_kp TAB LS(TAB)
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        // ===== レイヤー3: Keyball Layer 3 (F1-F24)。ボールはスクロールになる =====
        layer_3 {
            display-name = "L3";
            bindings = <
&trans     &trans   &trans   &trans   &trans   &trans                               &trans   &trans   &trans   &trans   &trans   &trans
&kp BSPC   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                               &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp BSPC
&trans     &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                              &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &kp DEL
&kp RSHFT  &kp F21  &kp F22  &kp F23  &kp F24  &trans   &to 4            &trans     &trans   &kp N9   &kp O    &kp L    &kp DOT  &kp RSHFT
&trans     &trans                              &kp N4   &kp N7           &kp ENTER  &kp RALT                            &trans   &trans
                    &trans   &trans                     &kp SPACE        &to 0                        &trans   &trans
                                                        &mo 3            &trans
           &trans   &trans   &trans                                                                   &trans   &trans   &trans
                                                        &trans   &trans  &trans
            >;
            sensor-bindings = <
                &scroll_left_right SCRL_LEFT SCRL_RIGHT
                &scroll_up_down SCRL_UP SCRL_DOWN
            >;
        };

        // ===== レイヤー4: Keyball Layer 1 ベース。数字は数字段 (レイヤー0 と同じ位置) を使い、
        //       空いた上段に 画面切り替え (左) と Office 編集 (右) のショートカットを配置 =====
        // Keyball に無いキーは &trans (レイヤー0 が透ける)
        layer_4 {
            display-name = "L1";
            bindings = <
&trans     &trans     &trans     &trans     &trans               &trans                              &trans    &trans    &trans     &trans     &trans     &trans
&kp PSCRN  &kp LA(TAB)  &kp LG(LC(LEFT))  &kp LG(TAB)  &kp LG(LC(RIGHT))  &kp LC(S)                              &kp F4    &kp F2    &kp LC(F)  &kp LC(PG_UP)  &kp LC(PG_DN)  &trans
&kp TAB    &kp HOME   &kp LC(Y)  &kp LC(A)  &kp LC(LA(LG(V)))    &kp HOME                            &kp LEFT  &kp UP    &kp RIGHT  &mkp MB1   &mkp MB2   &trans
&kp LCTRL  &kp RC(Z)  &kp RC(X)  &kp RC(C)  &kp RC(V)            &kp ESC    &kp SPACE          &trans    &mkp MB4  &kp DOWN  &mkp MB3   &kp PG_DN  &kp PG_UP  &trans
&trans     &trans                                                &kp JP_LT  &kp JP_RT      &kp ENTER &kp LALT                                  &trans     &to 0
                      &trans     &trans                                     &kp SPACE      &to 0                         &trans     &trans
                                                                            &mo 5          &trans
           &trans     &trans     &trans                                                                                  &trans     &trans     &trans
                                                                            &trans  &trans &trans
            >;
            sensor-bindings = <
                &inc_dec_kp LEFT_ARROW RIGHT_ARROW
                &inc_dec_kp UP_ARROW   DOWN_ARROW
            >;
        };

        // ===== レイヤー5: Keyball Layer 2 (記号・右手テンキー) =====
        // 左端の上段・下段は Remap の表示どおり「長押し = 修飾キー / タップ = 括弧」
        // 右手: 右端はレイヤー0 と同じ (&trans) / 右から2列目は上から ÷ × − + / 数字は電卓配列のまま1列左へ
        layer_5 {
            display-name = "L2";
            bindings = <
&trans               &trans        &trans      &trans       &trans        &trans                                     &kp JP_LBKT  &kp JP_RBKT  &trans  &trans  &kp JP_SLASH     &trans
&mt RCTRL JP_RPAR    &kp RS(N6)    &kp JP_YEN  &kp JP_SEMI  &kp JP_COLON  &kp RS(N1)                                 &kp RS(N8)   &kp N7       &kp N8  &kp N9  &kp RS(JP_COLON) &trans
&kp TAB              &kp RS(N5)    &kp JP_DLLR &kp JP_AT    &kp JP_SQT    &kp JP_TILDE                               &kp RS(N9)   &kp N4       &kp N5  &kp N6  &kp JP_MINUS     &trans
&mt LSHFT JP_LPAR    &kp JP_UNDER  &kp JP_LT   &kp JP_RT    &kp JP_DQT    &kp JP_PIPE   &to 3           &trans       &kp N0       &kp N1       &kp N2  &kp N3  &kp RS(JP_SEMI)  &trans
&trans               &trans                                               &kp COMMA     &kp DOT         &kp ENTER    &kp RS(JP_MINUS)                          &trans           &trans
                                   &trans      &trans                                   &none           &to 0                                  &trans  &trans
                                                                                        &trans          &trans
                     &trans        &trans      &trans                                                                                          &trans  &trans  &trans
                                                                                        &trans   &trans &trans
            >;
            sensor-bindings = <
                &inc_dec_kp LEFT_ARROW RIGHT_ARROW
                &inc_dec_kp UP_ARROW   DOWN_ARROW
            >;
        };

        // ===== レイヤー6: 自動マウス (ボールを動かした直後に約5秒間入る) =====
        // マウスボタンの位置を Keyball Layer 1 に合わせる: S=左 / H=右 / M=中 / G=戻る
        layer_6 {
            display-name = "AML";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans  &trans    &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB4  &trans  &mkp MB3  &trans    &trans    &trans
&trans  &trans                          &trans  &trans      &trans  &trans                                &trans    &trans
                &trans  &trans                  &trans      &trans                    &trans    &trans
                                                &trans      &trans
        &trans  &trans  &trans                                                        &trans    &trans    &trans
                                               &trans &trans &trans
            >;
        };
    };
};
