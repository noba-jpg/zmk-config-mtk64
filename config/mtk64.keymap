/*
 * mtk64ebt 用キーマップ: Corne v4 (Remap チートシート, 大西配列ベース) の移植版
 *
 * 置き場所: フォークした zmk-config-mtk64 の config/mtk64.keymap (上書き)
 * 対応ブランチ: right_left_rev4 / right_left_dongle_rev4 / right_left_rev3
 *   (この3ブランチは公式キーマップが同一。Rev3 のドングル系ブランチは別ファイルが必要)
 * OS のキーボード設定は「日本語 (JIS)」前提 (Corne と同じ)。
 *
 * ■ レイヤーの対応
 *   Corne Layer 0 -> レイヤー0 (DEF)
 *   Corne Layer 1 -> レイヤー4 (NUM)   TO(1)/MO(1) は &to 4 / &mo 4
 *   Corne Layer 2 -> レイヤー5 (SYM)   MO(2) は &mo 5
 *   レイヤー1 (精密モード・各種設定・BT切替) / 2 (マウス・Fキー) / 3 (スクロール) は公式のまま。
 *   レイヤー6 (自動マウス) は右内側キー1か所のみ変更 (下記)。
 *   Corne Layer 3 (RGB・Bootloader) は移植していない。
 *
 * ■ 物理配置の対応
 *   英字3段 (6列×3段)     -> 上から2〜4段目の同じ位置 (最上段の数字段は公式のまま)
 *   左親指  , . Space     -> 親指アーチ 外側から順に  ,  .  Space
 *   右親指  Click Enter Alt -> 親指アーチ 内側から順に  Click  Enter  Alt
 *   内側キー上段 (左 TO(1) / 右 MO(1)) -> 最下段の内側キー (? の右隣 / G の左隣)
 *   内側キー中段 (左 MO(2) / 右 MO(2)) -> 親指の一番手前の低いキー
 *
 * ■ Corne に無いキー (公式から変えたのは最下段外側の2つだけ)
 *   左下の角         : &mo 3 = 押している間スクロール (公式は LALT)
 *   右下の角の左隣   : &mo 1 = 押している間 精密モード + 設定キー + BT切替 (公式は ^)
 *   数字段 / 左下2つ目 (Win) / 右下の角 (円記号) / エンコーダー押し込み / フットスイッチ : 公式のまま
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include "keycode_japanese.h"

// スクロール量の設定
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mkp_input_listener {
    input-processors = <&zip_aml 6 5000>;
};

/ {
    behaviors {
        // 垂直スクロール用のbehaviorの設定
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>; // スクロールのタップ時間
        };
        // 水平スクロール用のbehaviorの設定
        scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>; // スクロールのタップ時間
        };
    };
};

/ {

    keymap {
        compatible = "zmk,keymap";

        // ===== レイヤー0: Corne Layer 0 (大西配列ベース) =====
        default_layer {
            display-name = "DEF";
            bindings = <
&kp ESC      &kp N1    &kp N2  &kp N3     &kp N4        &kp N5                                  &kp N6     &kp N7    &kp N8     &kp N9  &kp N0  &kp JP_MINUS
&kp JP_ZKHK  &kp Q     &kp L   &kp U      &kp JP_COLON  &kp JP_EXCL                             &kp F      &kp W     &kp R      &kp Y   &kp P   &kp BSPC
&kp JP_HENK  &kp E     &kp I   &kp A      &kp O         &kp JP_MINUS                            &kp K      &kp T     &kp N      &kp S   &kp H   &kp DEL
&kp RCTRL    &kp Z     &kp X   &kp C      &kp V         &kp JP_QMARK  &to 4           &mo 4     &kp G      &kp D     &kp M      &kp J   &kp B   &kp RSHFT
&mo 3        &kp LGUI                                   &kp COMMA     &kp DOT         &kp ENTER &kp LALT                                &mo 1   &kp JP_YEN
                       &tog 2  &kp ENTER                              &kp SPACE       &mkp MB1                       &kp ENTER  &tog 2
                                                                      &mo 5           &mo 5
             &mo 1     &mo 2   &mo 3                                                                                 &mo 1      &mo 2   &mo 3
                                                                      &mo 1    &mo 2  &mo 3
            >;

            sensor-bindings = <
                &inc_dec_kp LEFT_ARROW RIGHT_ARROW
                &inc_dec_kp UP_ARROW   DOWN_ARROW
            >;
        };

        // ===== レイヤー1: 精密モード・設定・BT切替 (公式のまま) =====
        layer_1 {
            display-name = "SNP";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5
                                                                    &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &studio_unlock
&trans  &kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                    &trans            &kp PG_UP          &kp UP_ARROW    &kp PG_DN             &trans                &scrl_inv_tog
&trans  &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                                &kp HOME          &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp END               &aml_tog
&trans  &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &mkp MB4       &mkp MB5          &mkp MB1           &mkp MB2        &mkp MB3              &trans                &cpi_inc
&trans  &trans                                                                         &trans        &trans         &trans         &trans                                                                     &trans                &cpi_dec
                                    &trans           &trans                                          &trans         &trans                                              &trans          &trans
                                                                                                     &trans         &trans
        &trans                      &trans           &trans                                                                                                             &trans          &trans                &trans
                                                                                                     &trans &trans  &trans
            >;
        };

        // ===== レイヤー2: マウス・Fキー (公式のまま) =====
        layer_2 {
            display-name = "MSE";
            bindings = <
&trans  &kp F1                      &kp F2           &kp F3           &kp F4           &kp F5                                      &kp F6            &kp F7             &kp F8          &kp F9                &kp F10               &kp F11
&trans  &kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                    &trans            &kp PG_UP          &kp UP_ARROW    &kp PG_DN             &trans                &trans
&trans  &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                                &kp HOME          &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp END               &trans
&trans  &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &mkp MB4       &mkp MB5          &mkp MB1           &mkp MB2        &mkp MB3              &trans                &trans
&trans  &trans                                                                         &trans        &trans         &trans         &trans                                                                     &trans                &trans
                                    &trans           &trans                                          &trans         &trans                                              &trans          &trans
                                                                                                     &trans         &trans
        &trans                      &trans           &trans                                                                                                             &trans          &trans                &trans
                                                                                                     &trans &trans  &trans
            >;
            sensor-bindings = <
                &inc_dec_kp TAB LS(TAB)
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        // ===== レイヤー3: スクロール (公式のまま) =====
        layer_3 {
            display-name = "SCR";
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans     &trans         &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                                                                               &trans         &trans                          &trans  &trans
                                        &trans          &trans                                       &trans         &trans          &trans  &trans
                                                                                                     &trans         &trans
                &trans                  &trans          &trans                                                                      &trans  &trans  &trans
            >;
            sensor-bindings = <
                &scroll_left_right SCRL_LEFT SCRL_RIGHT
                &scroll_up_down SCRL_UP SCRL_DOWN
            >;
        };

        // ===== レイヤー4: Corne Layer 1 (数字・矢印・Ctrl ショートカット) =====
        // Corne の空白キーは &none、Corne に無いキーは &trans (レイヤー0 が透ける)
        layer_4 {
            display-name = "NUM";
            bindings = <
&trans       &trans      &trans      &trans      &trans          &trans                                  &trans     &trans    &trans   &trans     &trans  &trans
&kp PSCRN    &kp N1      &kp N2      &kp N3      &kp N4          &kp N5                                  &kp N6     &kp N7    &kp N8   &kp N9     &kp N0  &kp BSPC
&kp JP_HENK  &none       &kp LC(Y)   &kp LC(A)   &kp LC(LS(V))   &kp JP_MINUS                            &kp LEFT   &kp DOWN  &kp UP   &kp RIGHT  &none   &kp DEL
&kp RCTRL    &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)       &kp JP_SLASH  &to 0           &mo 0     &none      &none     &none    &none      &none   &kp RSHFT
&trans       &trans                                              &kp COMMA     &kp DOT         &kp ENTER &kp RGUI                                 &trans  &trans
                         &trans      &trans                                    &kp SPACE       &to 0                          &trans   &trans
                                                                               &mo 5           &mo 5
             &trans      &trans      &trans                                                                                   &trans   &trans     &trans
                                                                               &trans   &trans &trans
            >;
        };

        // ===== レイヤー5: Corne Layer 2 (記号・右手テンキー) =====
        layer_5 {
            display-name = "SYM";
            bindings = <
&trans       &trans        &trans        &trans       &trans        &trans                                    &trans       &trans       &trans  &trans  &trans  &trans
&kp TAB      &kp JP_EXCL   &kp JP_DQT    &kp JP_HASH  &kp JP_DLLR   &kp JP_PRCNT                              &kp JP_LBKT  &kp JP_RBKT  &kp N7  &kp N8  &kp N9  &kp JP_PLUS
&kp JP_HENK  &kp JP_AMPS   &kp JP_TILDE  &kp JP_AT    &kp JP_SQT    &kp JP_MINUS                              &kp JP_LPAR  &kp JP_RPAR  &kp N4  &kp N5  &kp N6  &kp JP_MINUS
&kp RCTRL    &kp JP_CARET  &kp JP_ASTRK  &kp JP_SEMI  &kp JP_COLON  &kp JP_SLASH  &to 0           &mo 0       &kp JP_SLASH &kp N0       &kp N1  &kp N2  &kp N3  &kp JP_SLASH
&trans       &trans                                                 &kp JP_LT     &kp JP_RT       &kp ENTER   &kp JP_EQUAL                              &trans  &trans
                           &trans        &trans                                   &kp SPACE       &to 0                                 &trans  &trans
                                                                                  &mo 4           &mo 5
             &trans        &trans        &trans                                                                                         &trans  &trans  &trans
                                                                                  &trans   &trans &trans
            >;
        };

        // ===== レイヤー6: 自動マウス =====
        // 公式との差分: G の左隣 (レイヤー0 では &mo 4) を MB4 から &trans に変更。
        // ボール操作直後に NUM レイヤーへ入ろうとして「戻る」ボタンが出るのを防ぐため。
        layer_6 {
            display-name = "AML";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans          &mkp MB5        &mkp MB1        &mkp MB2        &mkp MB3  &trans  &trans
&trans  &trans                          &trans  &trans      &trans  &trans                          &trans  &trans
                &trans  &trans                  &trans      &trans                  &trans  &trans
                                                &trans      &trans
        &trans  &trans  &trans                                                      &trans  &trans  &trans
                                               &trans &trans &trans
            >;
        };
    };
};
